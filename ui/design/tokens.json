{
  "$schema": "./tokens.schema.json",
  "version": 1,
  "themes": {
    "light": {
      "name": "Light",
      "checked": true
    },
    "dark": {
      "name": "Dark",
      "checked": true
    },
    "oled": {
      "name": "Dark (OLED black)",
      "inherits": "dark",
      "checked": false
    }
  },
  "color": {
    "bg.base": {
      "light": "#FAFAF7",
      "dark": "#121214",
      "oled": "#000000"
    },
    "bg.surface1": {
      "light": "#FFFFFF",
      "dark": "#1A1A1F",
      "oled": "#0B0B0D"
    },
    "bg.surface2": {
      "light": "#F3F3EF",
      "dark": "#222229",
      "oled": "#151518"
    },
    "bg.surface3": {
      "light": "#EAEAE4",
      "dark": "#2B2B33",
      "oled": "#1E1E23"
    },
    "border.subtle": {
      "light": "#DCDCD4",
      "dark": "#34343D",
      "oled": "#26262C"
    },
    "border.strong": {
      "light": "#83837B",
      "dark": "#75757F",
      "oled": "#6C6C78"
    },
    "text.primary": {
      "light": "#18181B",
      "dark": "#EDEDF0"
    },
    "text.secondary": {
      "light": "#55555E",
      "dark": "#A9A9B4"
    },
    "text.tertiary": {
      "light": "#64646D",
      "dark": "#9A9AA5"
    },
    "accent": {
      "light": "{accent.marigold.accent}",
      "dark": "{accent.marigold.accent}"
    },
    "accent.subtle": {
      "light": "{accent.marigold.accent.subtle}",
      "dark": "{accent.marigold.accent.subtle}"
    },
    "on.accent": {
      "light": "{accent.marigold.on.accent}",
      "dark": "{accent.marigold.on.accent}"
    },
    "success": {
      "light": "#1A7446",
      "dark": "#3FB97A"
    },
    "warning": {
      "light": "#A14B00",
      "dark": "#F08A24"
    },
    "danger": {
      "light": "#C42B1C",
      "dark": "#F5675C"
    },
    "info": {
      "light": "#1C66AA",
      "dark": "#4AA3F0"
    }
  },
  "accent": {
    "default": "marigold",
    "options": {
      "marigold": {
        "name": "Marigold",
        "accent": {
          "light": "#915500",
          "dark": "#F2B544"
        },
        "accent.subtle": {
          "light": "#FFF1D6",
          "dark": "#3A2C10",
          "oled": "#2A1F08"
        },
        "on.accent": {
          "light": "#FFFFFF",
          "dark": "#1A1300"
        }
      }
    }
  },
  "mode": {
    "look": "{color.info}",
    "sandbox": "{color.success}",
    "direct": "{color.warning}",
    "direct_raw": "{color.danger}"
  },
  "font": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "indic": "Noto Sans Devanagari"
  },
  "type": {
    "caption": {
      "size": 12,
      "weight": 400,
      "lineHeight": 1.45
    },
    "small": {
      "size": 13,
      "weight": 400,
      "lineHeight": 1.45
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.45
    },
    "bodyLarge": {
      "size": 16,
      "weight": 400,
      "lineHeight": 1.45
    },
    "title": {
      "size": 20,
      "weight": 600,
      "lineHeight": 1.25
    },
    "headline": {
      "size": 24,
      "weight": 600,
      "lineHeight": 1.25
    },
    "display": {
      "size": 32,
      "weight": 600,
      "lineHeight": 1.25
    }
  },
  "space": [
    2,
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "control": 6,
    "card": 10,
    "panel": 16,
    "pill": "full"
  },
  "motion": {
    "micro": 120,
    "standard": 200,
    "panel": 320,
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "emphasised": [
        0.3,
        0,
        0,
        1
      ]
    }
  },
  "elevation": {
    "raised": {
      "light": {
        "shadow": {
          "y": 1,
          "blur": 3,
          "color": "#18181B1F"
        }
      },
      "dark": {
        "border": "{color.border.subtle}"
      }
    },
    "overlay": {
      "light": {
        "shadow": {
          "y": 8,
          "blur": 24,
          "color": "#18181B29"
        }
      },
      "dark": {
        "border": "{color.border.subtle}"
      }
    }
  },
  "focus": {
    "width": 2,
    "color": "{color.accent}"
  },
  "contrast": [
    {
      "fg": "text.primary",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "text.secondary",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "text.tertiary",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "accent",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "success",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "warning",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "danger",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "info",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "text"
    },
    {
      "fg": "text.primary",
      "bg": [
        "accent.subtle"
      ],
      "kind": "text"
    },
    {
      "fg": "on.accent",
      "bg": [
        "accent"
      ],
      "kind": "text"
    },
    {
      "fg": "border.strong",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "non-text"
    },
    {
      "fg": "focus",
      "bg": [
        "bg.base",
        "bg.surface1",
        "bg.surface2",
        "bg.surface3"
      ],
      "kind": "non-text"
    }
  ]
}
