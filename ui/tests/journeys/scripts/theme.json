{
  "methods": {
    "v1.settings.get": [
      {"params": {"key": "ui.theme"}, "result": {"key": "ui.theme", "value": "dark"}},
      {"params": {"key": "ui.bar.width_px"}, "result": {"key": "ui.bar.width_px", "value": 720}}
    ],
    "v1.events.subscribe": [{"result": {"subscription": "sub-1"}}],
    "v1.settings.set": [{
      "result": {},
      "broadcast": true,
      "notify": [{"delay_ms": 0, "method": "v1.events.event", "params": {"subscription": "sub-1", "event": {"event": {"type": "setting.changed", "payload": {"key": "ui.theme", "new": "light"}}}}}]
    }]
  }
}
