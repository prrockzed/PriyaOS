{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One weekly PR for all Rust crates.",
      "matchManagers": ["cargo"],
      "groupName": "Rust crates"
    },
    {
      "description": "One weekly PR for GitHub Action digests.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The CI image, referenced by digest in the workflows.",
      "matchPackageNames": ["ghcr.io/prrockzed/priyaos-ci"],
      "groupName": "CI image"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
