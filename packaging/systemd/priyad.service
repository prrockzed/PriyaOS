# The PriyaOS daemon: one per user, started with the session.
# Installed to /usr/lib/systemd/user/ by the package (0.14).

[Unit]
Description=PriyaOS background service
Documentation=https://github.com/prrockzed/PriyaOS

[Service]
# priyad says READY=1 once its socket answers, and STOPPING=1 on SIGTERM.
Type=notify
ExecStart=/usr/bin/priyad
Restart=on-failure
RestartSec=1
# priyad needs no more than the user already has.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
