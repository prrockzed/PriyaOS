# shellcheck shell=bash disable=SC2034,SC2154
# (makepkg reads the variables here and sets srcdir, pkgdir and startdir.)
#
# PriyaOS for any Arch (0.14), built from this checkout:
#   cd packaging/arch && makepkg -si
# packages whatever is checked out, uncommitted changes included.

pkgbase=priya
pkgname=(priya priya-shell)
pkgver=0.0.0
pkgrel=1
pkgdesc='PriyaOS: Priya AI and the Priya bar on any Arch'
arch=(x86_64 aarch64)
url='https://github.com/prrockzed/PriyaOS'
license=(Apache-2.0)
makedepends=(cargo git)
options=(!lto !debug)

# The checkout this PKGBUILD sits in.
_root() {
	realpath "$startdir/../.."
}

pkgver() {
	cd "$(_root)" || return
	printf '0.0.%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
	cd "$(_root)" || return
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
	cd "$(_root)" || return
	# Built in makepkg's folder, so the checkout's own target/ is untouched.
	CARGO_TARGET_DIR="$srcdir/target" cargo build --release --frozen -p priyad -p priya-cli
}

package_priya() {
	pkgdesc='PriyaOS core: priyad, the priya command and Priya AI'
	depends=(gcc-libs glibc)
	optdepends=(
		'ollama: answers from a model on this computer'
		'gnome-keyring: a keyring for model keys'
		'keepassxc: a keyring for model keys, with its Secret Service turned on'
	)
	install=priya.install
	local root bin
	root=$(_root)
	bin="$srcdir/target/release"
	install -Dm755 -t "$pkgdir/usr/bin" "$bin/priyad" "$bin/priya"
	install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$root/packaging/systemd/priyad.service"
	install -Dm644 -t "$pkgdir/usr/share/priya/defaults" "$root"/data/defaults/*.toml
	install -Dm644 -t "$pkgdir/usr/share/priya/prompts" "$root"/data/prompts/*.md
	install -Dm644 -t "$pkgdir/usr/share/priya/desktop" "$root"/data/desktop/hyprland.{lua,conf}
	install -dm755 "$pkgdir/usr/share/bash-completion/completions" \
		"$pkgdir/usr/share/zsh/site-functions" "$pkgdir/usr/share/fish/vendor_completions.d"
	"$bin/priya" completions bash >"$pkgdir/usr/share/bash-completion/completions/priya"
	"$bin/priya" completions zsh >"$pkgdir/usr/share/zsh/site-functions/_priya"
	"$bin/priya" completions fish >"$pkgdir/usr/share/fish/vendor_completions.d/priya.fish"
	install -Dm644 -t "$pkgdir/usr/share/licenses/priya" "$root/LICENSE" "$root/NOTICE" "$root/THIRD_PARTY.md"
}

package_priya-shell() {
	pkgdesc='PriyaOS desktop: the Priya bar, drawn by Quickshell'
	arch=(any)
	license=(Apache-2.0 ISC)
	# The same build as priyad: the UI's API names are generated from it.
	depends=("priya=$pkgver-$pkgrel" quickshell qt6-declarative qt6-svg inter-font ttf-jetbrains-mono noto-fonts)
	local root shell
	root=$(_root)
	shell="$pkgdir/usr/share/priya/shell"
	install -dm755 "$shell"
	cp -r --no-preserve=ownership "$root/ui/shell/priya/." "$shell/"
	# PriyaUI next to the config; the unit puts this folder on the QML
	# import path. Only what runs: no tests, no gallery.
	cp -r --no-preserve=ownership "$root/ui/PriyaUI" "$shell/PriyaUI"
	find "$shell" -type d -exec chmod 755 {} +
	find "$shell" -type f -exec chmod 644 {} +
	install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$root/packaging/systemd/priya-shell.service"
	install -Dm644 -t "$pkgdir/usr/share/licenses/priya-shell" "$root/LICENSE" "$root/NOTICE"
	# The Lucide icons' licence (ISC), named apart from PriyaOS's own.
	install -Dm644 "$root/ui/PriyaUI/icons/LICENSE" "$pkgdir/usr/share/licenses/priya-shell/LICENSE.lucide"
}
