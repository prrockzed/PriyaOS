{
  "$defs": {
    "SettingSource": {
      "description": "Where a settings change came from.",
      "enum": [
        "user",
        "natural-language",
        "module",
        "file",
        "rewind"
      ],
      "type": "string"
    }
  },
  "$id": "https://github.com/prrockzed/PriyaOS/blob/main/docs/claude/api/events/setting.changed.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A setting got a new value (or lost one: `new` is empty). Settings values\nare never `null`, so an empty `old`/`new` means \"not set\".",
  "properties": {
    "new": true,
    "old": true,
    "setting": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SettingSource"
    }
  },
  "required": [
    "setting",
    "source"
  ],
  "title": "setting.changed v1",
  "type": "object",
  "x-event-type": "setting.changed",
  "x-event-version": 1
}
