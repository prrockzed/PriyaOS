{
  "$id": "https://github.com/prrockzed/PriyaOS/blob/main/docs/claude/api/events/module.started.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A module process started.",
  "properties": {
    "module": {
      "type": "string"
    },
    "pid": {
